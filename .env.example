# Bitbucket Cloud
# For App Password auth (recommended):
#   1. Go to Bitbucket Settings > Personal settings > App passwords
#   2. Create with scopes: repository:read, pullrequest:read
#   3. Set both USERNAME and TOKEN
BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_REPO=your-repo
BITBUCKET_USERNAME=your-bitbucket-username
BITBUCKET_TOKEN=your-app-password

# For Repository Access Token (alternative):
#   1. Go to Repository Settings > Access tokens
#   2. Create token with repository:read scope
#   3. Set only TOKEN (leave USERNAME blank)
# BITBUCKET_TOKEN=your-repository-access-token

# JIRA Cloud
# 1. Go to https://id.atlassian.com/manage-profile/security/api-tokens
# 2. Create API token
# 3. Set EMAIL to your Atlassian account email
# 4. Set API_TOKEN to the generated token
JIRA_HOST=your-domain.atlassian.net
JIRA_PROJECT_KEY=PROJ
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token

# Debug mode (optional) - enables verbose logging
# DEBUG=true
